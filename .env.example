# ============================================
# ENVIRONMENT VARIABLES EXAMPLE - FRONTEND
# ============================================
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun
# Local development için: .env.local
# Production için: .env.production

# ============================================
# API Configuration
# ============================================
# Backend API URL
# Local: http://localhost:4000
# Production: https://api.gramkumbaram.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# API Request Timeout (milliseconds)
# Default: 30000 (30 seconds)
NEXT_PUBLIC_API_TIMEOUT=30000

# ============================================
# Frontend Configuration
# ============================================
# Frontend URL
# Local: http://localhost:3000
# Production: https://gramkumbaram.com
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ============================================
# Feature Flags
# ============================================
# Enable debug mode (console logs, detailed errors)
# true for development, false for production
NEXT_PUBLIC_ENABLE_DEBUG=true

# Enable mock API (for testing without backend)
# true to use mock data, false to use real API
NEXT_PUBLIC_ENABLE_MOCK_API=false
