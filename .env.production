# ============================================
# PRODUCTION ENVIRONMENT - FRONTEND
# ============================================
# Bu dosya production build için kullanılır
# Next.js build sırasında otomatik olarak yüklenir
# Docker build sırasında ARG olarak geçilebilir

# ============================================
# API Configuration
# ============================================
# Backend API URL (Production)
NEXT_PUBLIC_API_URL=https://api.gramkumbaram.com

# API Request Timeout (milliseconds)
NEXT_PUBLIC_API_TIMEOUT=30000

# ============================================
# Frontend Configuration
# ============================================
# Frontend URL (Production)
NEXT_PUBLIC_FRONTEND_URL=https://gramkumbaram.com

# ============================================
# Feature Flags (Production)
# ============================================
# Disable debug mode in production
NEXT_PUBLIC_ENABLE_DEBUG=false

# Disable mock API in production
NEXT_PUBLIC_ENABLE_MOCK_API=false
